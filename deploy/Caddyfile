# /etc/caddy/Caddyfile — HTTPS-сертификаты Let's Encrypt Caddy получает и
# продлевает сам, как только A-записи домена указывают на сервер.
alikhandev.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
	log {
		output file /var/log/caddy/alikhandev.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

# Один канонический адрес: www → без www.
www.alikhandev.com {
	redir https://alikhandev.com{uri} permanent
}

notes.alikhandev.com {
	encode zstd gzip
	request_body {
		max_size 20MB
	}
	reverse_proxy 127.0.0.1:3001
}
